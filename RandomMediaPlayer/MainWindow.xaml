<Window x:Class="RandomMediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Vlc="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf"
        Title="Random Media Player" Height="780" Width="1100"
        Icon="/photo-album-icon-png-3.jpg"
        ThemeMode="Dark"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Mode selector -->
            <RowDefinition Height="Auto"/>
            <!-- Folder buttons + monitor -->
            <RowDefinition Height="Auto"/>
            <!-- Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Hotkey config row -->
            <RowDefinition Height="Auto"/>
            <!-- Orientation + universal options -->
            <RowDefinition Height="Auto"/>
            <!-- Video-specific options -->
            <RowDefinition Height="100"/>
            <!-- Folder list -->
            <RowDefinition Height="Auto"/>
            <!-- Start + parameters -->
            <RowDefinition Height="Auto"/>
            <!-- File path -->
            <RowDefinition Height="*"/>
            <!-- Preview -->
        </Grid.RowDefinitions>

        <!-- Row 0: Mode selector header -->
        <Border Grid.Row="0" Background="#FF202020" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Random Media Player"
                           FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mode:" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <RadioButton x:Name="PhotoModeRadio" GroupName="Mode" Content="Photos"
                                 IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Checked="OnModeChanged"/>
                    <RadioButton x:Name="VideoModeRadio" GroupName="Mode" Content="Videos"
                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                 Checked="OnModeChanged"/>
                    <RadioButton x:Name="MixedModeRadio" GroupName="Mode" Content="Mixed"
                                 VerticalAlignment="Center"
                                 Checked="OnModeChanged"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="HoldStatusText"
                           Text=""
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="#FFFFA500" Margin="16,0,0,0"
                           ToolTip="When held, the slideshow timer is paused; videos loop on their current clip."/>
            </Grid>
        </Border>

        <!-- Row 1: Folder buttons + monitor combo -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="+ Add Folder" Click="BrowseFolderButton_Click"/>
            <Button Grid.Column="2" Content="Remove" Click="RemoveFolderButton_Click"/>
            <Button Grid.Column="4" Content="Clear All" Click="ClearFoldersButton_Click"/>
            <CheckBox Grid.Column="6" x:Name="PersistFoldersCheckBox"
                      Content="Persist folders"
                      VerticalAlignment="Center"
                      ToolTip="When checked, the selected folders list is saved between runs."/>
            <StackPanel Grid.Column="7" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Monitor:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="MonitorComboBox" MinWidth="240" MinHeight="32"
                          Padding="8,4" VerticalContentAlignment="Center"
                          SelectionChanged="MonitorComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Progress -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="FileEnumerationProgressBar" Grid.Column="0"
                         Minimum="0" Maximum="100" Value="0" Height="18"/>
            <Label x:Name="ProgressLabel" Grid.Column="2"
                   Content="Select folders to begin" Height="22" Padding="2,0"
                   VerticalContentAlignment="Center"/>
            <Label x:Name="FolderCountLabel" Grid.Column="4"
                   Content="Folders: 0" Height="22" Padding="2,0"
                   VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Row 3: Hotkey config (Panic + Hold) -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Panic Key (global)" Padding="8,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="PanicCtrlCheckBox" Content="Ctrl"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="PanicSettingChanged" Unchecked="PanicSettingChanged"/>
                    <CheckBox x:Name="PanicAltCheckBox" Content="Alt"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="PanicSettingChanged" Unchecked="PanicSettingChanged"/>
                    <ComboBox x:Name="PanicKeyComboBox" MinWidth="74" MinHeight="28"
                              VerticalContentAlignment="Center" Padding="6,2"
                              SelectionChanged="PanicSettingChanged" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PanicActionComboBox" MinWidth="120" MinHeight="28"
                              VerticalContentAlignment="Center" Padding="6,2"
                              SelectionChanged="PanicSettingChanged" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PanicStatusText"
                               Text=""
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               ToolTip="If 'Unavailable', the chosen combo is claimed by another app (NVIDIA ShadowPlay, capture tools). Add Ctrl/Alt or pick a different key."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Hold Key (global)" Padding="8,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="HoldCtrlCheckBox" Content="Ctrl"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="HoldSettingChanged" Unchecked="HoldSettingChanged"/>
                    <CheckBox x:Name="HoldAltCheckBox" Content="Alt"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="HoldSettingChanged" Unchecked="HoldSettingChanged"/>
                    <ComboBox x:Name="HoldKeyComboBox" MinWidth="74" MinHeight="28"
                              VerticalContentAlignment="Center" Padding="6,2"
                              SelectionChanged="HoldSettingChanged" Margin="0,0,6,0"/>
                    <TextBlock x:Name="HoldStatusBox"
                               Text=""
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               ToolTip="When pressed, the slideshow timer pauses and videos loop on their current clip until pressed again."/>
                </StackPanel>
            </GroupBox>

            <CheckBox Grid.Column="3" x:Name="MultiInstanceCheckBox"
                      Content="Multi-instance"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="MultiInstanceCheckBox_Changed"
                      Unchecked="MultiInstanceCheckBox_Changed"
                      ToolTip="When checked, panic and hold keys are observed via a low-level keyboard hook instead of being claimed exclusively. Multiple instances of this app can all respond to the same key. Side effect: the focused app may also receive the key (e.g., F11 in a browser would still toggle fullscreen)."/>
        </Grid>

        <!-- Row 4: Orientation filter + universal options -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Orientation Filter" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="AllOrientationRadio" GroupName="Orientation"
                                 Content="All" IsChecked="True"
                                 Checked="OnOrientationChanged"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="LandscapeRadio" GroupName="Orientation"
                                 Content="Landscape"
                                 Checked="OnOrientationChanged"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="VerticalRadio" GroupName="Orientation"
                                 Content="Vertical"
                                 Checked="OnOrientationChanged"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="IncludeAnimatedCheckBox"
                          Content="Include animated (gif / jfif)"
                          ToolTip="When checked, .gif / .gifv / .jfif / .apng files are included. In Photo mode they show as a static first frame; in Video / Mixed they animate."
                          IsChecked="False" VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="IncludeAnimatedCheckBox_Changed"
                          Unchecked="IncludeAnimatedCheckBox_Changed"/>
                <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on Top"
                          IsChecked="False" VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="AlwaysOnTopCheckBox_Changed"
                          Unchecked="AlwaysOnTopCheckBox_Changed"/>
                <CheckBox x:Name="ScaleToFillCheckBox" Content="Scale to Fill"
                          IsChecked="False" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Row 5: Mode-specific options (video/mixed only) -->
        <Grid Grid.Row="5" x:Name="VideoOptionsRow" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Video Options" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="MuteCheckBox" Content="Mute"
                              IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Min size:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="MinWidthTextBox" Text="500" Width="70"
                         TextChanged="MinSizeTextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBlock Text="x" Margin="6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="MinHeightTextBox" Text="500" Width="70"
                         TextChanged="MinSizeTextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Row 6: Folder list -->
        <GroupBox Grid.Row="6" Header="Selected Folders" Margin="0,0,0,8" Padding="4">
            <ListBox x:Name="SelectedFoldersListBox"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" ToolTip="{Binding}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Row 7: Start + delay -->
        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="StartShowButton"
                    Content="Start Slideshow" Click="StartStopSlideshowButton_Click"
                    Height="34" Padding="14,0" FontWeight="SemiBold" MinWidth="160"/>
            <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh List"
                    Click="RefreshButton_Click" Height="34" Padding="14,0" MinWidth="120"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DelayLabel" Text="Display time (s):"
                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBox x:Name="DelayTextBox" Text="3" Width="80"
                         TextChanged="DelayTextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Row 8: File path -->
        <TextBlock x:Name="FilePathTextBlock" Grid.Row="8"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   FontSize="13" Margin="0,0,0,8" VerticalAlignment="Center">
            <Hyperlink x:Name="FilePathHyperlink" Click="FilePathHyperlink_Click"
                       Foreground="#FF7B9FFF">
                (no media selected yet)
            </Hyperlink>
        </TextBlock>

        <!-- Row 9: Preview area - click to enlarge -->
        <Border Grid.Row="9" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="4">
            <Grid x:Name="MediaContainer" Background="Black"
                  MouseDown="MediaContainer_MouseDown"
                  ClipToBounds="True">
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
                <Vlc:VlcControl x:Name="VlcCanvas" Visibility="Collapsed"/>
                <MediaElement x:Name="GifPlayer"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="Uniform"
                              Visibility="Collapsed"
                              MediaEnded="GifPlayer_MediaEnded"/>
                <TextBlock x:Name="PreviewPlaceholder"
                           Text="Preview will appear here"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FF666666" FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>
