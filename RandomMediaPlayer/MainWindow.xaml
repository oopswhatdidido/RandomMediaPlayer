<Window x:Class="RandomMediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Vlc="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf"
        Title="Random Media Player" Height="820" Width="1180"
        Icon="/photo-album-icon-png-3.jpg"
        KeyDown="Window_KeyDown">

    <!-- No Window.Resources Styles - we let .NET 9 Fluent dark provide every
         default. Padding/sizing tweaks are now done inline per control where
         they matter. -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header: title + hold status -->
            <RowDefinition Height="Auto"/>
            <!-- Mode tabs (Photos / Videos / Mixed) -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar: folder buttons, refresh, start/stop, delay -->
            <RowDefinition Height="Auto"/>
            <!-- Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Settings tabs -->
            <RowDefinition Height="280"/>
            <!-- File path -->
            <RowDefinition Height="Auto"/>
            <!-- Preview (fills) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═════ Header row ═════ -->
        <!-- No Border background override - Fluent's default Window background
             flows through. Title + hold status only here; mode tabs moved to
             their own row so they can render with Fluent's full TabItem chrome. -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Random Media Player"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" x:Name="HoldStatusText"
                       Text=""
                       VerticalAlignment="Center" FontWeight="SemiBold"
                       ToolTip="When held, the slideshow timer is paused; videos loop on their current clip."/>
        </Grid>

        <!-- ═════ Mode tabs (Photos / Videos / Mixed) ═════ -->
        <!-- Native Fluent TabControl with no template override. Empty TabItems
             so the body strip is empty but still rendered. The selected tab
             drives _mode via OnModeTabChanged. -->
        <TabControl Grid.Row="1" x:Name="ModeTabControl"
                    Margin="0,0,0,8"
                    VerticalAlignment="Top"
                    SelectionChanged="OnModeTabChanged">
            <TabItem Header="Photos"/>
            <TabItem Header="Videos"/>
            <TabItem Header="Mixed"/>
        </TabControl>

        <!-- ═════ Toolbar ═════ -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="+ Add Folder" Click="BrowseFolderButton_Click" Margin="0,0,6,0"/>
                <Button Content="Remove" Click="RemoveFolderButton_Click" Margin="0,0,6,0"/>
                <Button Content="Clear All" Click="ClearFoldersButton_Click" Margin="0,0,12,0"/>
                <Button x:Name="RefreshButton" Content="Refresh List"
                        Click="RefreshButton_Click" Margin="0,0,12,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock x:Name="DelayLabel" Text="Display time (s):"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="DelayTextBox" Text="3" Width="60"
                         TextChanged="DelayTextBox_TextChanged"
                         VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="StartShowButton" Content="Start Slideshow"
                        Click="StartStopSlideshowButton_Click"
                        Height="32" Padding="14,0" FontWeight="SemiBold" MinWidth="160"/>
            </StackPanel>
        </Grid>

        <!-- ═════ Progress ═════ -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="FileEnumerationProgressBar" Grid.Column="0"
                         Minimum="0" Maximum="100" Value="0" Height="18"/>
            <Label x:Name="ProgressLabel" Grid.Column="2"
                   Content="Select folders to begin" Height="22" Padding="2,0"
                   VerticalContentAlignment="Center"/>
            <Label x:Name="FolderCountLabel" Grid.Column="4"
                   Content="Folders: 0" Height="22" Padding="2,0"
                   VerticalContentAlignment="Center"/>
        </Grid>

        <!-- ═════ Settings tabs ═════ -->
        <TabControl Grid.Row="4" Margin="0,0,0,8">

            <!-- ─── Sources ─── -->
            <TabItem Header="Sources">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" x:Name="PersistFoldersCheckBox"
                              Content="Persist folders between runs"
                              Margin="0,4,0,8"
                              ToolTip="When checked, the selected folders list is saved to settings.json."/>
                    <Border Grid.Row="1" BorderThickness="0">
                        <ListBox x:Name="SelectedFoldersListBox"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" ToolTip="{Binding}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── Monitors ─── -->
            <TabItem Header="Monitors">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,4,0,8">
                        <TextBlock Text="When multiple monitors are selected:"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <RadioButton x:Name="SyncMonitorsRadio" GroupName="MonitorMode"
                                     Content="All monitors show the same random item"
                                     IsChecked="True"
                                     Checked="OnMonitorModeChanged"
                                     Margin="8,2"/>
                        <RadioButton x:Name="IndependentMonitorsRadio" GroupName="MonitorMode"
                                     Content="Each monitor picks independently (per-monitor orientation applies)"
                                     Checked="OnMonitorModeChanged"
                                     Margin="8,2"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderThickness="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MonitorsItemsControl" Padding="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Click="MonitorSelectedChanged"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayLabel}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding OrientationOptions}"
                                                      SelectedItem="{Binding OrientationFilter, Mode=TwoWay}"
                                                      MinWidth="120" MinHeight="28"
                                                      Padding="6,2"
                                                      VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="Tip: Per-monitor orientation only applies in 'Each picks independently' mode. With no monitors checked, the slideshow plays only in this window's preview pane below."
                               Margin="0,8,0,0"
                               Opacity="0.65" FontStyle="Italic" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ─── Filters &amp; Display ─── -->
            <TabItem Header="Filters &amp; Display">
                <StackPanel Margin="6">
                    <GroupBox Header="Default Orientation Filter" Margin="0,4,0,8">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <RadioButton x:Name="AllOrientationRadio" GroupName="Orientation"
                                         Content="All" IsChecked="True"
                                         Checked="OnOrientationChanged"
                                         VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <RadioButton x:Name="LandscapeRadio" GroupName="Orientation"
                                         Content="Landscape"
                                         Checked="OnOrientationChanged"
                                         VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <RadioButton x:Name="VerticalRadio" GroupName="Orientation"
                                         Content="Vertical"
                                         Checked="OnOrientationChanged"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="(Used for the main preview, sync-mode monitors, and any monitor set to 'All' in independent mode)"
                                       Opacity="0.65" FontStyle="Italic"
                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>

                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="IncludeAnimatedCheckBox"
                                  Content="Include animated (gif / jfif)"
                                  ToolTip="When checked, .gif / .gifv / .jfif / .apng files are included. Photo mode shows them as a static first frame; Video / Mixed modes animate them."
                                  Margin="0,4,20,4"
                                  Checked="IncludeAnimatedCheckBox_Changed"
                                  Unchecked="IncludeAnimatedCheckBox_Changed"/>
                        <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on Top"
                                  Margin="0,4,20,4"
                                  Checked="AlwaysOnTopCheckBox_Changed"
                                  Unchecked="AlwaysOnTopCheckBox_Changed"/>
                        <CheckBox x:Name="ScaleToFillCheckBox" Content="Scale to Fill"
                                  Margin="0,4,20,4"/>
                        <CheckBox x:Name="MuteCheckBox" Content="Mute (videos)"
                                  IsChecked="True"
                                  Margin="0,4,20,4"/>
                        <CheckBox x:Name="ShowPathOverlayCheckBox"
                                  Content="Show file path overlay"
                                  ToolTip="When checked, each fullscreen window shows a clickable file-path strip along its bottom edge. Click it to open the file's folder in Explorer."
                                  Margin="0,4,20,4"
                                  Checked="ShowPathOverlayCheckBox_Changed"
                                  Unchecked="ShowPathOverlayCheckBox_Changed"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ThemeComboBox" MinWidth="120" MinHeight="28"
                                  VerticalContentAlignment="Center" Padding="6,2"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                        <TextBlock Text="(applies immediately; persisted between runs)"
                                   Opacity="0.65" FontStyle="Italic"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Min size:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="MinWidthTextBox" Text="500" Width="70"
                                 TextChanged="MinSizeTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="x" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="MinHeightTextBox" Text="500" Width="70"
                                 TextChanged="MinSizeTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="(filters photos, gifs, and videos by minimum pixel dimensions)"
                                   Opacity="0.65" FontStyle="Italic"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ─── Hotkeys ─── -->
            <TabItem Header="Hotkeys">
                <StackPanel Margin="6">
                    <GroupBox Header="Panic Key (global)" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
                            <CheckBox x:Name="PanicCtrlCheckBox" Content="Ctrl"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Checked="PanicSettingChanged" Unchecked="PanicSettingChanged"/>
                            <CheckBox x:Name="PanicAltCheckBox" Content="Alt"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Checked="PanicSettingChanged" Unchecked="PanicSettingChanged"/>
                            <ComboBox x:Name="PanicKeyComboBox" MinWidth="74" MinHeight="28"
                                      VerticalContentAlignment="Center" Padding="6,2"
                                      SelectionChanged="PanicSettingChanged" Margin="0,0,6,0"/>
                            <ComboBox x:Name="PanicActionComboBox" MinWidth="120" MinHeight="28"
                                      VerticalContentAlignment="Center" Padding="6,2"
                                      SelectionChanged="PanicSettingChanged" Margin="0,0,12,0"/>
                            <TextBlock x:Name="PanicStatusText" VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Hold Key (global)" Margin="0,4,0,4">
                        <StackPanel Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
                            <CheckBox x:Name="HoldCtrlCheckBox" Content="Ctrl"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Checked="HoldSettingChanged" Unchecked="HoldSettingChanged"/>
                            <CheckBox x:Name="HoldAltCheckBox" Content="Alt"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Checked="HoldSettingChanged" Unchecked="HoldSettingChanged"/>
                            <ComboBox x:Name="HoldKeyComboBox" MinWidth="74" MinHeight="28"
                                      VerticalContentAlignment="Center" Padding="6,2"
                                      SelectionChanged="HoldSettingChanged" Margin="0,0,12,0"/>
                            <TextBlock x:Name="HoldStatusBox" VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="MultiInstanceCheckBox"
                              Content="Multi-instance hotkeys (multiple app instances all respond to the same key)"
                              Margin="4,12,0,0"
                              Checked="MultiInstanceCheckBox_Changed"
                              Unchecked="MultiInstanceCheckBox_Changed"
                              ToolTip="When checked, hotkeys are observed via a low-level keyboard hook so multiple instances can all respond. The focused app may also receive the key."/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ═════ File path ═════ -->
        <TextBlock x:Name="FilePathTextBlock" Grid.Row="5"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   FontSize="13" Margin="0,0,0,8" VerticalAlignment="Center">
            <Hyperlink x:Name="FilePathHyperlink" Click="FilePathHyperlink_Click">
                (no media selected yet)
            </Hyperlink>
        </TextBlock>

        <!-- ═════ Preview pane (click to enlarge) ═════ -->
        <Border Grid.Row="6" BorderThickness="1" CornerRadius="4">
            <Grid x:Name="MediaContainer" Background="Black"
                  MouseDown="MediaContainer_MouseDown"
                  ClipToBounds="True">
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
                <Vlc:VlcControl x:Name="VlcCanvas" Visibility="Collapsed"/>
                <TextBlock x:Name="PreviewPlaceholder"
                           Text="Preview will appear here"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" Opacity="0.4" FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>
